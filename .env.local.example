# MedRecord Environment Configuration Template
# Copy this file to .env.local and replace the placeholder values with your real credentials.
# NEVER commit your real .env.local file to git!

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Gemini AI Extraction (Phase 3)
GEMINI_API_KEY=your-gemini-api-key-here

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt for Anonymizing Emergency Card Access IP Logs (Phase 5)
IP_HASH_SALT=your-random-salt-string-here
