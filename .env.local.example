# MedRecord Environment Configuration Template
# Copy this file to .env.local and replace the placeholder values with your real credentials.
# NEVER commit your real .env.local file to git!

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Gemini AI Extraction (Phase 3)
GEMINI_API_KEY=your-gemini-api-key-here
# Specify an active model available to your API key in Google AI Studio
GEMINI_MODEL=your-gemini-model-id

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt for Anonymizing Emergency Card Access IP Logs (Phase 5 - Required)
IP_HASH_SALT=your-random-salt-string-here

# Upstash Redis Rate Limiting (Required for distributed serverless deployments)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here
